#!/bin/bash
# Runs 08_dea_dotplots_networks.R on one core (see script 08).
# Submit: qsub new_scripts/run_script_08.pbs
#   -v EXTRA_ARGS="--contrast NAME"  extra options for the R script

#PBS -P PROJECT_CODE
#PBS -q normalbw
#PBS -l ncpus=1
#PBS -l mem=64GB
#PBS -l walltime=06:00:00
#PBS -l storage=gdata/PROJECT_CODE
#PBS -l wd
#PBS -r y
#PBS -N dea_08

set -euo pipefail

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

cd /path/to/project_root
module load R/4.3.1   # adjust to your Gadi R module

echo "=== run_script_08.pbs"
echo "=== host: $(hostname), date: $(date -u +%FT%TZ)"

Rscript new_scripts/08_dea_dotplots_networks.R ${EXTRA_ARGS:-}
