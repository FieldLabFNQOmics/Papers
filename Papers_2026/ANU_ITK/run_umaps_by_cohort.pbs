#!/bin/bash
# Runs umaps_by_cohort.R.
# Submit: qsub new_scripts/run_umaps_by_cohort.pbs

#PBS -P PROJECT_CODE
#PBS -q normalbw
#PBS -l ncpus=4
#PBS -l mem=64GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/PROJECT_CODE
#PBS -l wd
#PBS -r y
#PBS -N umaps_by_cohort

set -euo pipefail

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

cd /path/to/project_root
module load R/4.3.1   # adjust to your Gadi R module

echo "=== run_umaps_by_cohort.pbs"
echo "=== host: $(hostname), date: $(date -u +%FT%TZ)"

Rscript new_scripts/umaps_by_cohort.R
